// Run from repository root with: omc scripts/native_smoke.mos
print("DOMELICA_NATIVE_SMOKE_START\n");
print("Compiler: " + getVersion() + "\n");
if not loadModel(Modelica, {"4.1.0"}) then
  print("ERROR: cannot load MSL 4.1.0. Run scripts/install_msl.mos.\n");
  print(getErrorString());
  exit(1);
end if;
if not loadFile("DomelicaLab/package.mo") then
  print("ERROR: cannot load DomelicaLab/package.mo.\n");
  print(getErrorString());
  exit(1);
end if;
print("CHECKING authored 3D electromechanical model:\n");
print(checkModel(DomelicaLab.Examples.MotorizedPendulum3D) + "\n");
print(getErrorString());
simulate(
  DomelicaLab.Examples.MotorizedPendulum3D,
  stopTime=4,
  numberOfIntervals=400,
  tolerance=1e-6,
  outputFormat="csv",
  fileNamePrefix="m0_motorized_pendulum");
print(getErrorString());
if not regularFileExists("m0_motorized_pendulum_res.csv") then
  print("ERROR: authored pendulum simulation failed.\n");
  print(getErrorString());
  exit(1);
end if;
print("PASS pendulum: m0_motorized_pendulum_res.csv\n");

print("CHECKING authored thermal model:\n");
print(checkModel(DomelicaLab.Examples.HeatedBody) + "\n");
print(getErrorString());
simulate(
  DomelicaLab.Examples.HeatedBody,
  stopTime=5,
  numberOfIntervals=500,
  tolerance=1e-7,
  outputFormat="csv",
  fileNamePrefix="m0_thermal_step");
print(getErrorString());
if not regularFileExists("m0_thermal_step_res.csv") then
  print("ERROR: thermal simulation failed.\n");
  print(getErrorString());
  exit(1);
end if;
print("PASS thermal: m0_thermal_step_res.csv\n");

print("CHECKING unchanged MSL multibody baseline:\n");
simulate(
  Modelica.Mechanics.MultiBody.Examples.Elementary.DoublePendulum,
  stopTime=1,
  numberOfIntervals=200,
  tolerance=1e-6,
  outputFormat="csv",
  fileNamePrefix="m0_msl_double_pendulum");
print(getErrorString());
if not regularFileExists("m0_msl_double_pendulum_res.csv") then
  print("ERROR: MSL baseline simulation failed.\n");
  print(getErrorString());
  exit(1);
end if;
print("PASS MSL baseline: m0_msl_double_pendulum_res.csv\n");
print("DOMELICA_NATIVE_SMOKE_COMPLETE\n");
